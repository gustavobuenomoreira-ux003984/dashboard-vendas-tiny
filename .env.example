# Copie este arquivo para ".env" e coloque os seus valores reais.
# O arquivo .env NUNCA vai para o Git (já está no .gitignore).

# Token da API v2 do Tiny.
# Onde pegar: Tiny > Configurações > Geral > aba "Configurações da API" > Token da API
TINY_TOKEN=cole_aqui_o_seu_token

# Status que contam como venda válida (separados por vírgula).
# Ex.: Aprovado          |  Faturado          |  Aprovado,Faturado,Entregue
TINY_STATUS_VENDA=Aprovado,Faturado

# Pausa em segundos entre as chamadas da API (respeita o limite do Tiny).
TINY_PAUSA_SEGUNDOS=0.4

# Senha unica de acesso ao dashboard (a mesma para toda a equipe).
# Se ficar em branco, o app abre sem pedir senha (util so no seu computador).
APP_SENHA=troque_por_uma_senha_boa

# Banco Postgres (Neon) onde o cache fica guardado de forma permanente.
# Se ficar em branco, o app usa um arquivo SQLite local.
DATABASE_URL="postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require"
